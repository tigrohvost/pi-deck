{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PI DECK navigation metadata v1 (Package A)",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "scope",
    "fileCandidates",
    "textMatches",
    "truncated"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed",
        "cancelled"
      ]
    },
    "scope": {
      "type": "string"
    },
    "fileCandidates": {
      "type": "integer",
      "minimum": 0
    },
    "textMatches": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    }
  }
}
